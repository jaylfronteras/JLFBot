# JLFBot environment example. Copy to .env and fill in only what you need;
# every value is optional. .env is git-ignored — never commit real secrets.

# ── Local app / server (pnpm dev:server, pnpm jlfbot serve) ────────────────
# Data folder (default ~/.jlfbot; an existing ~/.openmausbot is reused in place).
JLFBOT_DATA_DIR=
# Harness server port (default 8799) and webhook listener port (default 8800).
JLFBOT_PORT=
JLFBOT_WEBHOOK_PORT=

# ── Optional self-hosted services (upstream's hosted ones are disabled) ────
# Your own deployment of cloudflare/composio-broker (managed Composio apps).
JLFBOT_COMPOSIO_BROKER_URL=
# Your own deployment of cloudflare/control-plane (phone relay / accounts).
JLFBOT_CONTROL_PLANE_URL=

# ── Docker Compose (compose.yaml) ──────────────────────────────────────────
COMPOSE_PROJECT_NAME=jlfbot
JLFBOT_BIND_ADDRESS=127.0.0.1
JLFBOT_HTTP_PORT=8080
# Leave empty to use http://localhost:${JLFBOT_HTTP_PORT:-8080}.
JLFBOT_PUBLIC_URL=
# Leave empty to inherit JLFBOT_PUBLIC_URL.
JLFBOT_WEBHOOK_PUBLIC_URL=
# For Tailscale Serve, set the HTTPS hostname (without scheme or path).
# Set JLFBOT_PUBLIC_URL to https:// followed by the same hostname.
# Requires JLFBOT_BIND_ADDRESS=127.0.0.1 and a trusted local HTTPS proxy.
JLFBOT_HTTPS_HOST=
# No image is published for JLFBot: build the base image yourself first with
#   docker build -t jlfbot:latest .
JLFBOT_BASE_IMAGE=jlfbot:latest
JLFBOT_LOCAL_IMAGE=jlfbot-local:latest
CADDY_IMAGE=caddy:2
# Explicitly empty ENGINES skips npm engine installation.
ENGINES="@anthropic-ai/claude-code @openai/codex"
# Leave empty for <COMPOSE_PROJECT_NAME>_data.
JLFBOT_DATA_VOLUME=
# Use true only when reusing a volume that already exists.
JLFBOT_DATA_EXTERNAL=false
