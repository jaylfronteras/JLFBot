{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "jlfbot-control-plane",
  "main": "src/index.ts",
  // No account_id here: wrangler reads CLOUDFLARE_ACCOUNT_ID from the
  // environment at deploy time, so nothing targets an account by default.
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  // No routes: add your own custom domain here before deploying, e.g.
  // "routes": [{ "pattern": "accounts.jlfbot.example.com", "custom_domain": true }],
  "workers_dev": false,
  // Placeholders: jlfbot.example.com is a reserved example domain and the
  // all-zero IDs are not real. Replace them with your own domain, account ID
  // and zone ID before deploying.
  "vars": {
    "BETTER_AUTH_URL": "https://accounts.jlfbot.example.com",
    "EMAIL_FROM": "noreply@jlfbot.example.com",
    "ALLOWED_ORIGINS": "",
    "CLOUDFLARE_ACCOUNT_ID": "00000000000000000000000000000000",
    "CLOUDFLARE_ZONE_ID": "00000000000000000000000000000000",
    "COMPANION_HOST_SUFFIX": "jlfbot.example.com"
  },
  "secrets": {
    "required": ["BETTER_AUTH_SECRET", "CLOUDFLARE_API_TOKEN"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jlfbot-control-plane",
      "database_id": "<YOUR_D1_DATABASE_ID>",
      "migrations_dir": "migrations"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["noreply@jlfbot.example.com"]
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  }
}
